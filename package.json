{
  "name": "korea-assembly-cc-chrome",
  "version": "1.0.15",
  "private": true,
  "type": "module",
  "scripts": {
    "build:inject": "node scripts/build-injected.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:injected": "node scripts/check-injected.mjs",
    "dev": "npm run build:inject && vite",
    "build": "npm run build:inject && vite build",
    "test": "vitest run",
    "test:e2e:extension": "npm run build && node scripts/extension-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify:e2e": "npm run build && node tests/e2e-smoke.mjs",
    "typecheck": "node scripts/run-tsc.mjs 7",
    "typecheck:ts6": "node scripts/run-tsc.mjs 6",
    "typecheck:ts7": "node scripts/run-tsc.mjs 7",
    "lint": "eslint .",
    "verify": "npm run check:version && npm run build:inject && npm run check:injected && npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.0.1",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.2",
    "playwright": "^1.59.1",
    "prettier": "^3.5.3",
    "sharp": "^0.35.5",
    "type-fest": "^5.1.0",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "vite": {
      "rollup": "^4.34.0"
    },
    "vitest": {
      "rollup": "^4.34.0"
    },
    "@crxjs/vite-plugin": {
      "rollup": "2.80.0"
    }
  }
}
