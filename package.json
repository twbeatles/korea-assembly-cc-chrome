{
  "name": "korea-assembly-cc-chrome",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "build:inject": "node scripts/build-injected.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:injected": "node scripts/check-injected.mjs",
    "dev": "npm run build:inject && vite",
    "build": "npm run build:inject && vite build",
    "test": "vitest run",
    "test:e2e:extension": "npm run build && node scripts/extension-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify:e2e": "npm run build && node tests/e2e-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "verify": "npm run check:version && npm run check:injected && npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.3",
    "@eslint/js": "^9.22.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.321",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.0.1",
    "globals": "^16.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^26.0.0",
    "playwright": "^1.59.1",
    "prettier": "^3.5.3",
    "type-fest": "^5.1.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.2",
    "vitest": "^3.0.8"
  },
  "overrides": {
    "@crxjs/vite-plugin": {
      "rollup": "2.80.0"
    }
  }
}
